async function json(u,o={}){return JSON.parse(await text(u,o))}
async function tmdb(id,type){
  try{
    const t=type==="movie"?"movie":"tv",d=await json(`https://api.themoviedb.org/3/${t}/${id}?api_key=${TMDB_KEY}&append_to_response=external_ids`);
    return{title:d?.name||d?.title||d?.original_name||d?.original_title||"Anime",year:(d?.first_air_date||d?.release_date||"").slice(0,4)}
  }catch(e){err("TMDB",e?.message);return null}
}

async function resolveMapping(id,type,season,episode){
  log("Mapping via IDMapper",id,type,`S${season}E${episode}`);
  try{
    const d=await json(`${MAPPER}?themoviedb_id=${encodeURIComponent(id)}`);
    if(!d)return null;
    const mapped=String(d.themoviedb_id||"")===String(id);
    if(!mapped||!d.anilist_id)return null;

    let ep=type==="movie"?1:Number(episode)||1;
    const maps=d.tmdb_mappings||{};
    const key=`s${Number(season)||1}`;
    const range=maps[key];

    if(type==="tv"&&range){
      const m=String(range).match(/^e(\d+)(?:-e(\d+))?$/i);
      if(m){
        const start=Number(m[1]);
        ep=Number(episode)+start-1;
      }
    }

    log("IDMapper mapped",d.anilist_id,`E${ep}`);
    return{anilistId:String(d.anilist_id),episode:ep,source:"idmapper"};
  }catch(e){err("IDMapper failed",e?.message);return null}
}

function slug(v){return String(v||"").toLowerCase().replace(/['’]/g,"").replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"")}
async function getSlug(id,type){try{const t=type==="movie"?"movie":"tv",d=await json(`${CIN}/${t}/tmdb:${id}.json`);return d?.meta?.slug||slug(d?.meta?.name||d?.meta?.title)}catch{return null}}
function fl(s,l){return Array.isArray(s)?s.filter(x=>x?.dataType?.toLowerCase()===l):[]}
async function embeds(sl,ep,l,aid){
  try{const d=await json(`/api/flix/${aid}/${ep}`,{headers:{Referer:abs(`/watch/${sl||"anime"}?ep=${ep}`)}});return d?.success?fl(d.servers,l):[]}catch{return[]}
}
