}
async function mkv(u){
  try{
    const id=String(u).match(/\/e\/([a-z0-9]+)/i)?.[1];if(!id)return null;
    const h={Accept:"*/*",Referer:`${FC}/`,"User-Agent":UA},r=await fetch(`${FC}/d/${id}/__data.json`,{headers:h});if(!r.ok)return null;
    const b=await r.text(),f=b.match(/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i)?.[0],t=b.match(/eyJ[\w-]+\.[\w-]+\.[\w-]+/)?.[0],q=b.match(/(\d{3,4}p)/)?.[1]||"1080p",z=b.match(/"(\d+(?:\.\d+)?\s*[KMG]B)"/i)?.[1]||"Unknown",b0=b.match(/https:\/\/[a-z0-9-]+\.flixcloud\.cc/i)?.[0]||FC;
    return f&&t?{url:`${b0}/download/${f}?token=${t}`,quality:q,size:z,headers:h}:null;
  }catch{return null}
}
async function getStreams(tmdbId,mediaType="tv",season=1,episode=1){
  try{
    if(!["tv","movie"].includes(mediaType))return[];
    const movie=mediaType==="movie",s=Number(season)||1,e=movie?1:Number(episode)||1,info=await tmdb(tmdbId,mediaType);
    if(!info)return[];
    const map=await resolveMapping(tmdbId,movie?"movie":"tv",s,e);if(!map)return[];
    const sl=await getSlug(tmdbId,mediaType),cfg=globalThis.SCRAPER_SETTINGS||{},langs=[];
    if(cfg.reanime_sub!==false)langs.push("sub");
    if(cfg.reanime_dub!==false)langs.push("dub");
    const jobs=[];
    for(const l of langs)for(const s of await embeds(sl,map.episode,l,map.anilistId))if(s?.dataLink)jobs.push((async()=>{
      const d=await mkv(s.dataLink);
      if(d)return{name:`Reanime [${l.toUpperCase()}] ${s.serverName||"HD"} (${d.quality})`,title:info.title,url:d.url,quality:d.quality,size:d.size,headers:d.headers,provider:"reanime",type:"mkv"};
      try{const h=await hls(s.dataLink);return{name:`Reanime [${l.toUpperCase()}] ${s.serverName||"HD"} (Auto)`,title:info.title,url:h.url,quality:"Auto",provider:"reanime",type:"m3u8",subtitles:h.subtitles}}catch{return null}
    })());
    return(await Promise.all(jobs)).filter(Boolean);
  }catch(e){err("FATAL",e?.stack||e?.message);return[]}
}
async function onSettings(){return[
  {type:"header",label:"Reanime"},
  {type:"toggle",key:"reanime_sub",label:"Subtitles",defaultValue:true},
  {type:"toggle",key:"reanime_dub",label:"Dub",defaultValue:true}
]}
module.exports={getStreams,onSettings};
