function abs(p,b=base){return!p?"":/^https?:\/\//i.test(p)?p:`${b}${p.startsWith("/")?"":"/"}${p}`}
async function text(u,o={}){
  const xs=/^https?:\/\//i.test(u)?[u]:DOM.map(d=>abs(u,d));let last;
  for(const x of xs)try{
    const r=await fetch(x,{...o,headers:{"User-Agent":UA,"Accept":"application/json, text/plain, */*",...(o.headers||{})}});
    log("HTTP",r.status,x);
    if(r.ok){if(xs.length>1)base=new URL(x).origin;return r.text()}
    last=Error(`HTTP ${r.status}`);
  }catch(e){last=e}
