function ssr(h){const m=h.match(/\{type:"data",data:(\{)/);if(!m)throw Error("SSR");const s=h.indexOf("{",m.index+m[0].length-1);let d=0;for(let i=s;i<h.length;i++){if(h[i]==="{")d++;else if(h[i]==="}"&&! --d)return h.slice(s,i+1)}throw Error("SSR")}
async function hls(u){
  const m=String(u).match(/\/e\/([^?#\s]+)(?:\?v=(\d+))?/i);if(!m)throw Error("Embed");
  const v=Number(m[2])||2,r=await fetch(`${FC}/e/${m[1]}?v=${v}`,{headers:{"User-Agent":UA,Accept:"*/*",Referer:"https://reanime.to/"}});
  if(!r.ok)throw Error(`FC ${r.status}`);
  const d=Function(`"use strict";return(${ssr(await r.text())});`)(),f=fields(d.obfuscation_seed),o=d.obfuscated_crypto_data?.[f.c]?.[f.a]?.[0]?.[f.o];if(!o)throw Error("Crypto");
  const frag=b64(o[f.k]),iv=b64(o[f.iv]),k2=b64(d[f.k2]),tok=d[f.t],tr=await fetch(`${FC}/api/m3u8/${tok}`,{headers:{Accept:"*/*","User-Agent":UA,Referer:`${FC}/`});
  if(!tr.ok)throw Error(`M3U8 ${tr.status}`);
  const td=await tr.json(),vb=b64(td[sha(tok+"vid").slice(0,10)]),T=b64(td[sha(tok+"key").slice(0,10)]),wo=await wasm(d.w_payload,frag,k2,T,parseInt(d.obfuscation_seed.slice(0,8),16)),p=CryptoJS.PBKDF2(uw(wo),CryptoJS.enc.Utf8.parse(d.obfuscation_seed),{keySize:8,iterations:1000,hasher:CryptoJS.algo.SHA256}),x=wu(p);
  for(let i=0;i<32;i++)x[i]^=d.obfuscation_seed.charCodeAt(i%d.obfuscation_seed.length);
  const out=CryptoJS.enc.Utf8.stringify(CryptoJS.AES.decrypt({ciphertext:uw(vb)},CryptoJS.SHA256(uw(x)),{iv:uw(iv),mode:CryptoJS.mode.CBC,padding:CryptoJS.pad.Pkcs7})).trim();
  if(!/^https?:\/\//i.test(out))throw Error("Bad URL");
